# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — your real keys stay private...
.env*
# ...but the blank template is safe to share, so others know what to fill in.
!.env.example

# waitlist signups (customer emails — never commit these)
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
