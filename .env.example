# Copy this file to `.env.local` and fill in what you need.
# `.env.local` is ignored by git, so your keys stay private.

# The public address of the site. Used for link previews when you deploy.
# Optional in local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Timezone used for the "Joined at" column, e.g. 2026/08/15 13:23.
# Defaults to America/Los_Angeles (Seattle).
WAITLIST_TIMEZONE=America/Los_Angeles

# ---------------------------------------------------------------------------
# Waitlist → Google Sheets
#
# On your computer, signups are saved to data/waitlist.csv as a safety net.
# Once deployed, that safety net is gone (hosts like Vercel have a read-only
# filesystem), so GOOGLE_SHEETS_WEBHOOK_URL becomes REQUIRED in production.
# Pick ONE of the two options. See README.md for step-by-step setup.
# ---------------------------------------------------------------------------

# Option 1 (easiest) — deploy the Apps Script from the README as a Web App
# and paste its /exec URL here.
GOOGLE_SHEETS_WEBHOOK_URL=

# Option 2 — a Google Cloud service account with the Sheets API enabled.
# Share the spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
# The ID is the long string in the sheet URL: /spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=brewlong-waitlist@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes — the key contains literal \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# Name of the tab to append to. Defaults to Sheet1.
GOOGLE_SHEETS_TAB=Sheet1
